# ─────────────────────────────────────────────────────────────────────────────
# TripMate AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                    # development | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tripmate:tripmate@localhost:5432/tripmate

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET_KEY=another-long-random-secret-for-jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─────────────────────────────────────────────────────────────────────────────
# LLM API Keys — add the provider(s) you want to use
# LiteLLM routes calls automatically based on model name prefixes
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                  # Required for gpt-4o, gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...           # Optional: claude-3-5-sonnet, etc.
GROQ_API_KEY=gsk_...                   # Optional: llama3-70b-8192 (free tier)
GEMINI_API_KEY=AIza...                 # Optional: gemini-2.0-flash

# LiteLLM proxy (optional — use if you have a LiteLLM proxy server running)
# LITELLM_BASE_URL=http://localhost:4000

# ── Model Routing ─────────────────────────────────────────────────────────────
FLIGHT_AGENT_MODEL=groq/openai/gpt-oss-20b
HOTEL_AGENT_MODEL=groq/openai/gpt-oss-20b
WEATHER_AGENT_MODEL=groq/openai/gpt-oss-20b
BUDGET_AGENT_MODEL=groq/openai/gpt-oss-20b
GUARDRAIL_MODEL=groq/openai/gpt-oss-20b
SUPERVISOR_MODEL=groq/openai/gpt-oss-120b
ITINERARY_AGENT_MODEL=groq/openai/gpt-oss-120b
FINAL_AGENT_MODEL=groq/openai/gpt-oss-120b

# ─────────────────────────────────────────────────────────────────────────────
# External Data APIs
# All are optional — mock data is used if keys are not provided
# ─────────────────────────────────────────────────────────────────────────────
AVIATIONSTACK_API_KEY=         # https://aviationstack.com (free: 500 req/month)
TAVILY_API_KEY=tvly-...        # https://tavily.com (free: 1000 req/month)
OPENWEATHER_API_KEY=           # https://openweathermap.org (free tier available)
EXCHANGERATE_API_KEY=          # https://exchangerate-api.com (free: 1500 req/month)

# ── MCP Server Ports ──────────────────────────────────────────────────────────
MCP_FLIGHT_PORT=8001
MCP_HOTEL_PORT=8002
MCP_WEATHER_PORT=8003
MCP_BUDGET_PORT=8004

# ── ChromaDB (RAG vector store) ───────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8005
CHROMA_COLLECTION_NAME=tripmate_knowledge
RAG_TOP_K=5

# ── HITL Settings ─────────────────────────────────────────────────────────────
HITL_TIMEOUT_SECONDS=300        # How long to wait for user review (5 min)
HITL_AUTO_APPROVE_AFTER_TIMEOUT=false

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                 # text (dev) | json (production)
